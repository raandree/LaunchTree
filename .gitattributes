# Normalize text files and use platform-appropriate source endings.
* text=auto

*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf

*.exe binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.nupkg binary
*.png binary
*.so binary
*.svg binary
*.zip binary
